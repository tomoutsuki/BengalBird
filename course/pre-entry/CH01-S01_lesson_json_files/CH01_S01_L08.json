      "lines": [
        {
          "type": "line",
          "speaker": "A",
          "bengali": "নমস্কার।",
          "romanized": "nomoshkar."
        },
        {
          "type": "choice",
          "question": {
            "en": "How can B reply politely?"
          },
          "options": [
            {
              "text": {
                "bengali": "নমস্কার।",
                "romanized": "nomoshkar.",
                "en": "Hello."
              },
              "correct": true
            },
            {
              "text": {
                "bengali": "ধন্যবাদ।",
                "romanized": "dhonnobad.",
                "en": "Thank you."
              },
              "correct": false
            },
            {
              "text": {
                "bengali": "হ্যালো।",
                "romanized": "hyalo.",
                "en": "Hello."
              },
              "correct": true
            }
          ]
        }
      ],
      "hint": {
        "en": "Both নমস্কার and হ্যালো can greet; নমস্কার is the safer polite choice."
      }
